# Brewfile - Homebrew packages and apps for a new Mac
#   install everything:   brew bundle --file=~/Projects/dotfiles/Brewfile
#   see what's missing:   brew bundle check --file=~/Projects/dotfiles/Brewfile

# Command-line fuzzy finder written in Go
brew "fzf"
# Distributed revision control system (newer than Apple's built-in git)
brew "git"
# Port scanning utility for large networks
brew "nmap"
# File browser
brew "ranger"
# Search tool like grep and The Silver Searcher
brew "ripgrep"
# Static analysis for shell scripts (infra's make check uses it)
brew "shellcheck"
# Terminal multiplexer
brew "tmux"
# Directory listing as a tree
brew "tree"
# Desktop password and login vault
cask "bitwarden"
# Web browser focusing on privacy
cask "brave-browser"
# Native GUI for Homebrew casks
cask "caskhub"
# Anthropic's official Claude AI desktop app
cask "claude"
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Web browser (used for the admin portal)
cask "firefox"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Markdown notes; the infra repo's docs/ is a vault
cask "obsidian"
# Music streaming service
cask "spotify"
# General-purpose text editor
cask "textmate"
# Virtual machines UI using QEMU
cask "utm"
