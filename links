# links - every file install.sh (and the homelab Ansible users role) links into $HOME.
# One entry per line: <path in this repo>  <destination, relative to $HOME>  <profile>
#   core     - shell, editor, git: installed everywhere, servers included
#   desktop  - GUI/interactive tools: installed by install.sh, skipped by Ansible
# Whitespace-separated; paths must not contain spaces. Blank lines and # comments ignored.

zshrc              .zshrc                core
zprofile           .zprofile             core
bashrc             .bashrc               core
vimrc              .vimrc                core
vim                .vim                  core
tmux.conf          .tmux.conf            core
gitconfig          .gitconfig            core
gitignore_global   .config/git/ignore    core
gitconfig-github   .config/git/github    core

ranger             .config/ranger        desktop
ghostty            .config/ghostty       desktop
ssh/config         .ssh/config           desktop
