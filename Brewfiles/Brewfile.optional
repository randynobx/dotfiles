# Optional apps: pre-vetted, but NOT part of any install.
# This file is a catalog. Do not run `brew bundle` on it; bootstrap.sh refuses it.
# To install one app, copy its line into a temp file and run:
#   brew bundle --file=/tmp/one-app.Brewfile

