# ~/.ssh/config - generic client settings (linked by install.sh, desktop profile).
# Host-specific and private entries go in ~/.ssh/config.d/; nothing here names a host.

# Before any Host block: an Include inside one would only apply to that block.
Include config.d/*

# UseKeychain (passphrase from the macOS Keychain) is macOS-only; IgnoreUnknown lets the
# same file work on Linux.
Host *
    IgnoreUnknown UseKeychain
    UseKeychain yes
    AddKeysToAgent yes
    IdentityFile ~/.ssh/id_ed25519
