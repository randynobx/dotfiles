# ~/.gitconfig - global git settings (linked by install.sh)

[user]
    name = Randy Nance
    useConfigOnly = true        # no email configured: refuse to commit, never guess user@host

[init]
    defaultBranch = main        # new repos start on main, not master

[pull]
    ff = only                   # pull never creates surprise merge commits

[push]
    autoSetupRemote = true      # first push of a new branch sets upstream (git >= 2.37)

[fetch]
    prune = true                # drop local refs to branches deleted on the remote

[rebase]
    autoStash = true            # rebase works with uncommitted changes

[merge]
    conflictStyle = diff3       # conflicts also show the original text

[diff]
    algorithm = histogram       # cleaner, more readable diffs

[alias]
    lg = log --graph --all --format='%C(auto)%h %d %s %C(dim)%an, %ar'   # all branches as a graph
    last = log -1 --stat                    # what did I just commit?
    unstage = restore --staged              # opposite of git add
    undo = reset --soft HEAD~1              # un-commit, keep changes staged
    amend = commit --amend --no-edit        # fold staged changes into last commit
    branches = branch -vv --sort=-committerdate   # branches, most recent first

# Per-machine settings (default email, signing key), untracked. Overrides the above.
[include]
    path = ~/.gitconfig.local

# Repos with a github.com remote commit as the GitHub noreply address.
# After .gitconfig.local, so it overrides the default email set there.
[includeIf "hasconfig:remote.*.url:https://github.com/**"]
    path = ~/.config/git/github
[includeIf "hasconfig:remote.*.url:git@github.com:*/**"]
    path = ~/.config/git/github
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/**"]
    path = ~/.config/git/github
